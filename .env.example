# AcoustID API key. Get one at https://acoustid.org/new-application
ACOUSTID_API_KEY=PASTE_YOUR_ACOUSTID_API_KEY_HERE

# Filename pattern used when renaming. Placeholders: {title} {artist} {album} {ext}
AUDIO_CLASSIFIER_PATTERN={title} - {artist}.{ext}

# Minimum AcoustID score required to accept a match (0.0-1.0)
AUDIO_CLASSIFIER_MIN_SCORE=0.85

# Write ID3 tags on MP3 files by default (true/false)
AUDIO_CLASSIFIER_WRITE_TAGS=true

# Enrich metadata (album, date, track number, genre) via MusicBrainz (true/false)
AUDIO_CLASSIFIER_MUSICBRAINZ=true

# Contact (email or URL) sent in the MusicBrainz User-Agent, as their etiquette asks
AUDIO_CLASSIFIER_CONTACT=

# Fill missing genres from Last.fm tags (true/false). Skipped without a key.
AUDIO_CLASSIFIER_LASTFM=true

# Last.fm API key. Free, from https://www.last.fm/api/account/create
LASTFM_API_KEY=
